%table.table.table-hover.pending-tests-table
  %thead
    %tr
      %th Topic
      %th Decks
      %th Cards (gesammt)
      %th Status
      %th(width="115px")

  %tbody.table-group-divider
    - tests.each do |test|
      %tr
        %td= test.topic
        %td= test.decks_count
        %td= test.topic.cards_count
        %td
          -# TODO: Das sollte vlt in einem Helper oder sowas leben?
          -# Es sollte noch den Status geben "Es gibt zu diesem Topic bereits einen Test. Diesen Test entweder Abschließen oder Abbrechen"
          -# Vlt wäre es sogar besser die Pending Tests und Started Tests Views zu mergen?
          - if test.ready?
            = "Es stehen #{test.pending_cards_count} Cards zur Abfrage bereit"
          - elsif test.cards_count == 0
            = "Dieses Deck hat noch keine Cards"
          - else
            = "Nächster Test in #{test.days_till_next_test} Tagen"
        %td
          - if test.ready?
            = link_to tests_path(test: { topic_id: test.topic.id }), data: { turbo_method: :post } do
              .btn.btn-sm.btn-primary
                Test Starten
